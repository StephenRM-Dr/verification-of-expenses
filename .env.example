# Base de datos (Neon Postgres)
DATABASE_URL=postgresql://usuario:password@host.neon.tech/neondb?sslmode=require

# Puerto del servidor HTTP
PORT=8080

# Almacenamiento de comprobantes (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2...)
# Si estas variables NO están definidas, los archivos se guardan en el disco local
# (./cargas-brailer). Eso sirve para desarrollo, pero en Koyeb el disco es efímero:
# todo lo subido se pierde en el siguiente reinicio o deploy.
# Con Neon Object Storage usa los nombres estándar de AWS, que es lo que Neon
# inyecta; el código acepta ambos juegos de nombres indistintamente.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=financiero

# Alternativa con otro proveedor (Cloudflare R2, AWS S3, Backblaze B2):
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
