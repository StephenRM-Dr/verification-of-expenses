# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# HTTP server port
PORT=8080

# Receipt storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2...)
# If these variables are NOT set, files are stored on the local disk
# (./cargas-brailer). That is fine for development, but on Koyeb the disk is ephemeral:
# everything uploaded is lost on the next restart or deploy.
# With Neon Object Storage use the standard AWS names, which is what Neon
# injects; the code accepts both sets of names interchangeably.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=financiero

# Alternative with another provider (Cloudflare R2, AWS S3, Backblaze B2):
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
